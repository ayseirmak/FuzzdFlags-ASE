  COMMAND = cd /users/a_irmak/mutators/build && /usr/bin/cmake --regenerate-during-build -S/users/a_irmak/mutators -B/users/a_irmak/mutators/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build utils-fuzzer: phony libutils-fuzzer.a

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: /users/a_irmak/mutators/build

build all: phony libutils-fuzzer.a constant-mutator delete-mutator duplicate-mutator jump-mutator expression-mutator

